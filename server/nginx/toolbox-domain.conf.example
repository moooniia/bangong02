# 备案通过后启用：
# 1. cp toolbox-domain.conf.example /etc/nginx/conf.d/toolbox-domain.conf
# 2. 阿里云 DNS 添加 A 记录 bangong02.com -> 139.196.28.78
# 3. certbot certonly --nginx -d bangong02.com -d www.bangong02.com
# 4. 取消下方 SSL 行注释并 nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name bangong02.com www.bangong02.com;

    root /home/toolbox/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 100m;
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}

