<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppCanvasBrush" Color="#F6F7FA" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FAFAFC" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1C1D21" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#767983" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E7E9EE" />
            <SolidColorBrush x:Key="TableHeaderBrush" Color="#282C36" />
            <SolidColorBrush x:Key="PreviewBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF0F6" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EAF8F1" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF6DF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppCanvasBrush" Color="#15171B" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#202329" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#262A31" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F6F8" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#A7ABB5" />
            <SolidColorBrush x:Key="DividerBrush" Color="#343942" />
            <SolidColorBrush x:Key="TableHeaderBrush" Color="#0F1115" />
            <SolidColorBrush x:Key="PreviewBrush" Color="#101216" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#3B2530" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#19362B" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#3B321E" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <SolidColorBrush x:Key="AccentBrush" Color="#ED478A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#24A86B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D58A18" />
    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="42" />
    </Style>
</ResourceDictionary>
